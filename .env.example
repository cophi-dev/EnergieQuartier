# ── Öffentliche URLs (Client) ──
NEXT_PUBLIC_SPEICHERPILOT_URL=https://speicherpilot.app

# Optional: Empfänger für „Per E-Mail senden“ auf der Kontaktseite
# NEXT_PUBLIC_CONTACT_EMAIL=beratung@ihre-firma.de

# ── LLM / Grok (xAI) – NUR Server, niemals NEXT_PUBLIC_ ──
# API-Key von https://console.x.ai/
# Echten Key in .env.local eintragen (Datei anlegen: cp .env.example .env.local)
XAI_API_KEY=

LLM_PROVIDER=grok
LLM_MODEL=grok-4.3
LLM_BASE_URL=https://api.x.ai/v1
LLM_TIMEOUT_MS=12000

